@startuml class_bank_queue_v28
title Классы модели электронной очереди банка\nВариант 28

skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

class SimulationConfig {
  + rates : array<double, 3>
  + windows : int
  + bufferCapacity : int
  + service : array<ServiceInterval, 4>
  + seed : uint32_t
}
class ServiceInterval {
  + minimum : double
  + maximum : double
}
class Request {
  + id : int
  + source : int
  + operation : int
  + arrival : double
  + serviceStart : double
  + serviceDuration : double
}
class Device {
  + request : optional<Request>
  + finishTime : double
  + busyTime : double
}
class Event {
  + time : double
  + type : EventType
  + index : int
  + sequence : uint64_t
}
enum EventType {
  ServiceEnd
  Arrival
}
class EventLater {
  + operator()(a : const Event&, b : const Event&) const : bool
}
class Simulator {
  - config : SimulationConfig
  - target : int
  - result : RunResult
  - calendar : priority_queue<Event, vector<Event>, EventLater>
  - buffer : vector<optional<Request>>
  - packagePending : deque<int>
  - activePackageSource : int
  - activeInService : int
  - devicePointer : int
  - now : double
  .. Календарь и запуск ..
  + run() : RunResult
  - scheduleNextArrival(source : int) : void
  - addEvent(type : EventType, index : int, time : double) : void
  - processServiceEnd(deviceId : int) : void
  .. Диспетчер постановки ..
  - processArrival(source : int) : void
  - firstFreeSlot() const : int
  - oldestSlot() const : int
  .. Диспетчер выбора ..
  - dispatch() : void
  - formPackage() : bool
  - nextFreeDevice() const : int
  - eraseFromPackage(slot : int) : void
  - removeFromBuffer(slot : int) : Request
  - startService(deviceId : int, request : Request) : void
  .. ОД1 ..
  - printState() const : void
}
class RunResult {
  + sources : array<SourceStats, 3>
  + devices : vector<Device>
  + totalTime : double
  + totalGenerated : int
  + totalRejected : int
  + rejectionProbability() const : double
}
class SourceStats {
  + generated : int
  + served : int
  + rejected : int
  + wait : Moments
  + service : Moments
  + system : Moments
  + rejectionProbability() const : double
}
class Moments {
  + count : int
  + mean : double
  + squaredDeviation : double
  + add(value : double) : void
  + variance() const : double
}

SimulationConfig *-- "4" ServiceInterval
Simulator *-up- SimulationConfig : параметры
Simulator *-right- "0..*" Event : календарь
Simulator *-left- "0..*" Request : буфер
Simulator *-down- RunResult : итог прогона
Simulator ..> EventLater : порядок календаря
Event --> EventType
EventLater ..> Event
RunResult *-- "3" SourceStats
RunResult *-- "1..*" Device
SourceStats *-- "3" Moments
Device *-- "0..1" Request : талон в окне

@enduml
